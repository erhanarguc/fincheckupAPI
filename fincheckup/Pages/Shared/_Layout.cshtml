    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <link href="~/css/devextreme/bootstrap.css" rel="stylesheet" />
    <!-- Custom Css -->
    <!-- Custom Css -->
    <link rel="stylesheet" href="/assets/css/main.css">
    <link href="/assets/css/toastr.css" rel="stylesheet" />
    <link href="/css/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/css/color_skins.css">
    <link href="~/assets/css/sweetalert2.min.css" rel="stylesheet" />
    <link href="/css/devextreme/dx.common.css" rel="stylesheet" />
    <link href="/css/devextreme/dx.light.css" rel="stylesheet" />
    <script src="/js/devextreme/jquery.js"></script>
    <script src="~/js/devextreme/jszip.js"></script>
    <script src="/js/devextreme/dx.all.js"></script>

    <script src="/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
    <script src="/js/devextreme/aspnet/dx.aspnet.data.js"></script>
    <script src="~/js/devextreme/localization/dx.messages.tr.js"></script>
    @RenderSection("Styles", false)
    <script>
        DevExpress.localization.locale("tr");

    </script>
    <style>
        #slctCompany .dx-texteditor-input {
            text-align: right;
        }

        #slctYear .dx-texteditor-input {
            text-align: center;
        }

        #slctCompany .productname {
            text-align: right;
        }

        #maincrd {
            background-color: #2F96B4;
            background-position: 5px center;
            background-repeat: no-repeat;
            -moz-box-shadow: 0 0 12px #000;
            -webkit-box-shadow: 0 0 12px #000;
            box-shadow: 0 0 3px #000;
            color: #FFF;
            opacity: .9;
            font-size: medium;
            -ms-filter: progid:DXImageTransform.Microsoft.Alpha(Opacity=100);
            filter: alpha(opacity=100)
        }
    </style>
</head>
<body class="theme-black  menu_sm">


    @{
        bool IsConsole = false;
        long UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
        var usr = HhvnUsers.GetRow_User(UserID);
        int chkKonsole = HhvnUsers.GetRow_UserKonsolide(UserID);
        if (chkKonsole>0)
        {
            IsConsole = true;
        }
    }

    @if (!String.IsNullOrEmpty(usr.qnbUserId))
    {
        Context.Response.Redirect("/admin/qnb/upload");
    }

    <!-- Page Loader -->
    <div class="page-loader-wrapper">
        <div class="loader">
            <div class="m-t-30"><img src="/finnlogo.png" width="48" height="48" alt="FinCheckup"></div>
            <p>Lütfen Bekleyiniz...</p>
        </div>
    </div>
    <div class="overlay_menu">
        <button class="btn btn-primary btn-icon btn-icon-mini btn-round"><i class="zmdi zmdi-close"></i></button>
        <div class="container">
            <div class="row clearfix">
                <div class="card">
                    <div class="body">
                        <div class="input-group m-b-0">
                            <input type="text" class="form-control" placeholder="Search...">
                            <span class="input-group-addon">
                                <i class="zmdi zmdi-search"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card links">
                    <div class="body">
                        <div class="row">
                            <div class="col-lg-3 col-md-6 col-sm-12">

                            </div>
                            <div class="col-lg-3 col-md-6 col-sm-12">

                            </div>
                            <div class="col-lg-3 col-md-6 col-sm-12">

                            </div>
                            <div class="col-lg-3 col-md-6 col-sm-12">

                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="row clearfix">

            </div>
        </div>
    </div>
    <div class="overlay"></div><!-- Overlay For Sidebars -->
    <!-- Left Sidebar -->
    <aside id="minileftbar" class="minileftbar">
        <ul class="menu_list">
            <li>
                <a href="javascript:void(0);" class="bars"></a>
                <a class="navbar-brand" href="/admin/firmpanel"><img src="/finnlogo.png" alt="FinCheckup"></a>
            </li>

            <li><a href="javascript:void(0);" class="menu-sm"><i class="zmdi zmdi-swap"></i></a></li>


            <li><a href="javascript:void(0);" class="fullscreen" data-provide="fullscreen"><i class="zmdi zmdi-fullscreen"></i></a></li>
            <li class="power">

                <a asp-page="/logout" asp-page-handler="logout" class="mega-menu"><i class="zmdi zmdi-power"></i></a>
            </li>
        </ul>
    </aside>
    <aside class="right_menu">

        <div id="rightsidebar" class="right-sidebar">
            <ul class="nav nav-tabs">
                <li class="nav-item"> </li>
            </ul>
            <div class="tab-content slim_scroll">
                <div class="tab-pane slideRight active" id="setting">

                    <div class="card">
                        <div class="header">
                            <h2><i class="fa fa-info-circle"></i> &nbsp;&nbsp;<strong>Info</strong> </h2>
                        </div>
                        <div class="body">
                            <div id="maincrd"></div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
        <div id="leftsidebar" class="sidebar">
            <div class="menu">
                <ul class="list">
                    <li>
                        <div class="user-info m-b-20">
                            <div class="image">
                                <a href="/admin/firmpanel"><img src="/finnlogo.png" alt="User"></a>
                            </div>
                            <div class="detail">
                                <h6>FinCheckup</h6>
                                <p class="m-b-0">  Yönetim Paneli</p>

                            </div>
                        </div>
                    </li>
                    <li class="header">E-DEFTER YÜKLEME</li>
                    <li>
                        <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-pages"></i><span>E-Defter Paneli</span> </a>
                        <ul class="ml-menu">
                            <li> <a href="/admin/upload">E-Defter Yükleme</a></li>
                            <li> <a href="/admin/upload">E-Defter YüklemeKontrol</a></li>
                        </ul>


                    </li>
                    <li class="header">DENETİM & UYARILAR</li>
                    <li>

                        <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-pages"></i><span>Denetim & Uyarılar</span> </a>
                        <ul class="ml-menu">

                            <li> <a href="/admin/upaccount">Muhasebe Kayıtları Uyarılar</a></li>
                            <li> <a href="/admin/upcheck">Vergi Ve İç Denetim Uyarılar</a></li>
                            <li> <a href="/admin/upbalance">Mizan Kontrol Raporu</a></li>
                            <li> <a href="/admin/Dashboard">Dashboard</a></li>
                        </ul>


                    </li>
                    <li class="header">KLASİK MALİ TABLOLAR & MİZAN</li>
                    <li>

                        <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-pages"></i><span>Klasik Mali Tablolar & Mizan</span> </a>
                        <ul class="ml-menu">
                            <li> <a href="/admin/dashbilanco">Bilanço</a></li>
                            <li> <a href="/admin/financeshrt">Bilanço Yıllık Trend</a></li>
                            <li> <a href="/admin/financeshrtneo">Bilanço Yıllık Trend Özet</a></li>
                            <li> <a href="/admin/dashrevenue">Gelir Tablosu</a></li>
                            <li> <a href="/admin/upbalance">Mizan</a></li>
                        </ul>

                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Master"))
                    {
                        <li style="display:none" class="header">SATILAN MALIN/HİZMETİN MALİYETİ HESAPLAMA</li>
                        <li style="display:none">
                            <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-chart"></i><span style=" ">Maliyet Hesaplama</span> </a>
                            <ul class="ml-menu">

                                <li> <a href="/admin/yonetim/uploadsmm">Maliyet Hesaplama Ekranı </a></li>
                                <li> <a href="/admin/yonetim/smm/dashbilanco">Bilanço Trend</a></li>
                                <li> <a href="/admin/yonetim/smm/dashrevenue">Gelir Tablosu Trend</a></li>
                            </ul>
                        </li>

                    }
                    <li class="header">RİSK ANALİZ PANELİ</li>
                    <li>
                        <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-flag"></i><span>Finansal Risk Analizi </span> </a>
                        <ul class="ml-menu">
                            <li> <a href="/admin/financeshrtview">Finansal Özet Paneli</a></li>
                            <li> <a href="/admin/upreportmain">Finansal Sağlık & Sektörel Risk Analizi Raporu</a></li>
                               <li> <a href="/admin/reportmaintest">Finansal Sağlık & Sektörel Risk Analizi Raporu(Yeni)</a></li>
                            <li> <a href="/admin/reportmain">Dashborad-Karlılık & Nakit Takip</a></li>
                            <li> <a href="/admin/dashrasyo">Dashboard-Rasyo Trend Takip </a></li>
                        </ul>


                    </li>
                    <li class="header">NAKİT YÖNETİMİ</li>
                    <li>
                        <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-chart"></i><span style=" ">Nakit Risk Yönetimi</span> </a>
                        <ul class="ml-menu">
                            <li> <a href="/admin/cashflow">Nakit Akışı</a></li>
                            <li> <a href="/admin/dashworkingcapital">İşletme Sermayesi</a></li>
                            <li> <a href="/admin/dashliquidity">Likidite Riski</a></li>
                        </ul>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Master"))
                    {
                        <li class="header">CLIENT PERFORMANCE MANAGEMENT  </li>
                        <li>
                            <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-chart"></i><span style=" ">CPM Paneli</span> </a>
                            <ul class="ml-menu"> 
                                <li> <a href="/admin/dashcrm">CRM Raporları</a></li>
                           
                            </ul>
                        </li>


                        <li class="header">Erken Uyarı  </li>
                        <li>
                            <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-chart"></i><span style=" ">Erken Uyarı  </span> </a>
                            <ul class="ml-menu"> 
                                <li> <a href="/admin/warn/companyjoblist">Erken Uyarı Seçimi</a></li>
                            </ul>
                        </li>

                    }


                    @if (User.IsInRole("Admin") || User.IsInRole("Master"))
                    {
                        <li class="header">KOR BANKACILIK MALİ ANALİZ PANELİ </li>
                        <li>
                            <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-chart"></i><span>Aktarma-Arındırma</span> </a>
                            <ul class="ml-menu">

                                <li> <a href="/admin/yonetim/uppageaktarma">Aktarma-Arındırma Paneli</a></li>
                                <li> <a href="/admin/yonetim/aktarma/dashbilanco">Bilanço Trend</a></li>
                                <li> <a href="/admin/yonetim/aktarma/dashrevenue">Gelir Tablosu Trend</a></li>

                            </ul>
                        </li>
                        @if (IsConsole)
                        {
                            <li>
                                <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-chart"></i><span>Konsolidasyon</span> </a>
                                <ul class="ml-menu">

                                    <li> <a href="/admin/upcmconsole">Konsolidasyon Paneli</a></li>
                                    <li> <a href="/admin/konsol/dashbilancokon">Bilanço Trend</a></li>
                                    <li> <a href="/admin/konsol/dasgrevenuekon">Gelir Tablosu Trend</a></li>

                                </ul>
                            </li>
                        }

                        <li>


                            <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-chart"></i><span> Journal Form</span> </a>
                            <ul class="ml-menu">

                                <li> <a href="/admin/uppageaktarmajrnl">Journal Form  Paneli</a></li>
                                <li> <a href="/admin/dashbilancojrnl">Bilanço Trend</a></li>
                                <li> <a href="/admin/dashrevenuejrnl">Gelir Tablosu Trend</a></li>
                                <li> <a href="/admin/uppageaktarmamzn">Mizan</a></li>
                            </ul>
                        </li>

                        if (User.IsInRole("Master"))
                        {
                            <li class="header">QNB RAPOR</li>
                            <li>
                                <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-chart"></i><span style=" ">QNB Rapor</span> </a>
                                <ul class="ml-menu">

                                    <li> <a href="/admin/upreportqnb">QNB Rapor </a></li>
                                </ul>
                            </li>
                            
                         

                        }





                    }
                    <li class="header">Firmalar</li>
                    <li>
                        <a href="javascript:void(0);" class="menu-toggle"><i class="zmdi zmdi-account-box"></i><span>Firma Listesi </span> </a>
                        <ul class="ml-menu">
                            <li> <a href="/admin/yonetim/companylist">Firmalar</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </aside>
    <!-- Main Content -->


    @RenderBody()


    <!-- Jquery Core Js -->
    @*<script src="/assets/bundles/libscripts.bundle.js"></script>*@     <!-- Lib Scripts Plugin Js -->
    <script src="/assets/bundles/vendorscripts.bundle.js"></script> <!-- Lib Scripts Plugin Js -->
    <script src="/assets/bundles/mainscripts.bundle.js"></script>
    <script src="~/assets/js/sweetalert2.min.js"></script>
    <script src="~/assets/js/toastr.js"></script>
    @RenderSection("Scripts", required: false)
    <script>
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "newestOnTop": true,
            "progressBar": true,
            "maxOpened": 1,
            "positionClass": "toast-top-left",
            "preventDuplicates": true,
            "preventOpenDuplicates": true,
            "onclick": null,
            "showDuration": "3000",
            "hideDuration": "1000",
            "timeOut": "10000",
            "allowHtml": true,
            "extendedTimeOut": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        }

    </script>




</body>

</html>

