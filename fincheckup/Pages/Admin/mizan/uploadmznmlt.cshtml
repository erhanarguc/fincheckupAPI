                                                }
                                            });
                                        },
                                        404: function () {
                                            alert("Script 404");
                                        }
                                    },
                                    contentType: false,
                                    data: fdatam,
                                    processData: false,
                                    cache: false,
                                    success: function (data) {
                                        if (data == "nok") {
                                            //swal.close();
