                    function readURL(input) {

                        var reader = new FileReader();

                        compid = $("#txtcurcomide").val();




                        if (input.files && input.files[0]) {

                            var fdatam = new FormData();
                            var tttdate = $("#mainmonth").val() + "_" + $("#mainyear").val();
                            for (var i = 0; i < input.files.length; i++) {
                                fdatam.append('file', input.files[i]);
                            }

                            reader.onload = function (e) {

                                var imgur = e.target.result;
                            };
                            reader.readAsDataURL(input.files[0]);
                            fdatam.append('id', $("#mainyear").val());
