@using System.Globalization
@functions {
    public class IndexModel : PageModel
    {
        public IEnumerable<YearResult> myearResult;
        public long UserID;
        public string CompName { get; set; }
        public long CompID;
        public int CompCount;
        public int YearCount;
        public HhvnUsers CurrentUser;
        public DashYearlyBilancoChart ncart;
        public List<DashBilancoView> nRequestList;
        
        public List<DashBilancoView> nRequestListChk;
        public IEnumerable<Companies> mreqListCompany;
        public string NetIsletme { get; set; }
        public string CariOran { get; set; }
        public decimal CariOranT { get; set; }
        public string NakitOran { get; set; }
        public Int64 val1 { get; set; }
        public Int64 val3 { get; set; }
        public void OnGet()
        {




            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));

            mreqListCompany = Companies.Getby_User(UserID);

            CompID = mreqListCompany.Where(x => x.IsDefault == 1).FirstOrDefault().ID;
            CompName = mreqListCompany.Where(x => x.IsDefault == 1).FirstOrDefault().CompanyName;
            HhvnUsers.SetYearMain(CompID, UserID);
            CurrentUser = HhvnUsers.GetRow_User(UserID);
            YearCount = TBLXml.GetYearByComapnyID(CompID);
            CompCount = mreqListCompany.Count();

            myearResult = YearResult.getValue();

            nRequestList = DashGelirTablosu.Get_MAINRESULT(CurrentUser.SelectedYear, CompID);
            //nRequestListTx = DashBilancoViewTx.setDashBilanco(nRequestList);

            //ncart = new DashYearlyBilancoChart();
            //ncart.SetResult(nRequestList, CurrentUser.SelectedYear);


            nRequestListChk = nRequestList;
            //DashGelirTablosuViewMain.getList(CurrentUser.SelectedYear, CompID);

            val1 = nRequestListChk.Where(x => x.TypeID == 111).Sum(x => x.OverViewTotal);
            val3 = nRequestListChk.Where(x => x.TypeID == 2222).Sum(x => x.OverViewTotal);
            if (val3 < 0) { val3 = val3 * -1; }
            NetIsletme = (val1 - val3).ToString("0,0.00", new CultureInfo("en-US", false));

            // DashBilancoViewMain.getNetIsletme(CurrentUser.SelectedYear, CompID);
            var val5 = nRequestListChk.Where(x => x.TypeID == 333).Sum(x => x.OverViewTotal);
            if (val5 == 0)
            {
                val5 = 1;
            }
            CariOranT = (Convert.ToDecimal(nRequestListChk.Where(x => x.TypeID == 111).Sum(x => x.OverViewTotal)) / Convert.ToDecimal(val5));
            if (CariOranT < 0)
            {
                CariOranT = CariOranT * -1;
            }
            CariOran = CariOranT.ToString("0,0.00", new CultureInfo("en-US", false));
            //DashBilancoViewMain.getCariOran(CurrentUser.SelectedYear, CompID).ToString("F");
            NakitOran = (Convert.ToDecimal(nRequestListChk.Where(x => (x.TypeID == 10 || x.TypeID == 11)).Sum(x => x.OverViewTotal)) / Convert.ToDecimal(val5)).ToString("N2");
            //DashBilancoViewMain.getNakitOran(CurrentUser.SelectedYear, CompID).ToString("F");
        }

        
        public JsonResult OnGetGraphYear(int nyear)
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            HhvnUsers.SetYear(nyear, UserID);
            return new JsonResult("ok");
        }
        public JsonResult OnGetChartRasyo(DataSourceLoadOptions options)
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);

            CompID = Companies.Getby_User(UserID).Where(x => x.IsDefault == 1).FirstOrDefault().ID;
            nRequestList = DashGelirTablosu.Get_MAINRESULT(CurrentUser.SelectedYear, CompID).Where(x => x.IsHidden == 0).ToList();
            //nRequestListTx = DashBilancoViewTx.setDashBilanco(nRequestList);

            ncart = new DashYearlyBilancoChart();
            ncart.SetResult(nRequestList, CurrentUser.SelectedYear);

            return new JsonResult(DataSourceLoader.Load(ncart.nresult, options));
        }
        public JsonResult OnGetMarkupMarjin(DataSourceLoadOptions options, string myear, long compid)
        {
            List<DashBilancoViewMulti> chklist = new List<DashBilancoViewMulti>();
            if (string.IsNullOrEmpty(myear))
            {
                return new JsonResult(DataSourceLoader.Load(chklist, options));
            }


            string[] llist = myear.Split(',');
            if (llist.Length < 0)
            {
                return new JsonResult(DataSourceLoader.Load(chklist, options));
            }
            var tt = llist.Select(int.Parse).ToList();

            var chk = DashGelirTablosu.Get_MAINRESULTMulti(tt.ToArray(), compid);
            return new JsonResult(DataSourceLoader.Load(chk, options));
        }
       
    }
}
