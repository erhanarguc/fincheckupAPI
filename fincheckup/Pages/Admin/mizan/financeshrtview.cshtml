        public JsonResult OnGetMarkupMarjin(DataSourceLoadOptions options, int myear, long compid)
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));

            if (!HhvnUsers.CheckUser(compid, UserID))
            {
                return new JsonResult(DataSourceLoader.Load(new List<YearlyReportMarkupMarjin>(), options));
            }


            IEnumerable<YearlyReportDashGraphic> mrequestResult_1 = ReportDash.Get_Data_GrossProfitGraphic(myear, compid);


            return new JsonResult(DataSourceLoader.Load(mrequestResult_1, options));
        }
        public JsonResult OnGetEbitMarjin(DataSourceLoadOptions options, int myear, long compid)
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));

            if (!HhvnUsers.CheckUser(compid, UserID))
            {
                return new JsonResult(DataSourceLoader.Load(new List<YearlyReportMarkupMarjin>(), options));
            }

            var retval = ReportDash.Get_Data_EbitMarjin(myear, compid);
            return new JsonResult(DataSourceLoader.Load(retval, options));
        }
        public JsonResult OnGetWorkingCapital(DataSourceLoadOptions options, int myear, long compid)
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));

