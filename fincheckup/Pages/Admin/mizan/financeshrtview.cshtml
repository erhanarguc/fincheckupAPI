            DashYearlyResultWorkingCapital chk = ReportDash.Get_Data_WorkingCapital(myear, compid);
            int lastmont = ReportDash.Get_LastMonthYear(myear, compid);
            //DashYearlyResultWorkingCapital chk1 = DashYearlyResultWorkingCapital.setProp(lastmont, chk);
            dashWorkingCapital = DashYearlyResultChart.SetResultMain(chk, myear);


