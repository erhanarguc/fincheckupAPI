    <script src="~/js/polyfill.min.js"></script>

    <script>
        function funczone(data) {
            var turl = '/admin/reportmaintest?handler=CheckUrl&fileID=' + data;

 
            $.ajax({
                type: "GET",
                url: turl,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {


      
                    console.log(response);

                    if (response == "nok") {
                        Swal.fire(
                            'Uyarı!',
                            'Hata Kaydı Bulunamadı!',
                            'error'
                        )
                        return;
                    }
                    else {
 
                        var chkdomain = $(location).attr('host');


                        const myArray = response.split("/");
                        let word = myArray[1];
                        var url = 'https://' + chkdomain + '/' + response;
                        // window.location.href = 'https://' + chkdomain + response;
                        console.log(url);
                        var link = document.createElement('a');
                        link.href = url;
                        link.download = word;
                        link.dispatchEvent(new MouseEvent('click'));
                    }

                },
                failure: function (response) {
                    alert(response);
                }
            });


        
        }
     
