    public class IndexModel : PageModel
    {
        public IEnumerable<YearResult> myearResult;
        public long UserID;
        public long CompID;
        public int CompCount;
        public string CompName;
        public int YearCount;
        public long curcomID;
        public int curcomCount;
        public HhvnUsers CurrentUser;
        public int YearCurrent;
        public List<CompanyQnbReport> reportList;

        public IEnumerable<Companies> mreqListCompany;
        public Companies curCompany;


        public string currentcompname { get; set; }

        public void OnGet()
        {
            myearResult = YearResult.getValue();



            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);
            mreqListCompany = Companies.Getby_User(UserID);
            curCompany = mreqListCompany.Where(x => x.IsDefault == 1).FirstOrDefault();
            CompName = mreqListCompany.Where(x => x.IsDefault == 1).FirstOrDefault().CompanyName;
            currentcompname = curCompany.CompanyName;
            curcomID = curCompany.ID;
            curcomCount = mreqListCompany.Count();
            reportList = CompanyQnbReport.Get_CompanyReportList(curcomID).OrderByDescending(x => x.ID).ToList();

            CompID = curCompany.ID;
            YearCount = TBLXml.GetYearByComapnyID(CompID);
            CompCount = mreqListCompany.Count();
            YearCurrent = CurrentUser.SelectedYear;
        }




        public JsonResult OnGetSalerDate(DataSourceLoadOptions options)
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);

            curcomID = Companies.Getby_User(UserID).Where(x => x.IsDefault == 1).FirstOrDefault().ID;

            var currentUploadM = ReportSetMain.Get_StatbyCompanyMain(curcomID);


            return new JsonResult(DataSourceLoader.Load(currentUploadM.OrderBy(x => x.MainMonth).ToList(), options));

        }
        public JsonResult OnGetSalerYear(DataSourceLoadOptions options)
        {


            var YearSetm = YearResult.getValue().OrderByDescending(x => x.MYear);
            return new JsonResult(DataSourceLoader.Load(YearSetm, options));

        }
        public JsonResult OnGetSalerComp(DataSourceLoadOptions options)
        {

            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            mreqListCompany = Companies.Getby_User(UserID);
            return new JsonResult(DataSourceLoader.Load(mreqListCompany, options));

        }
 
        public JsonResult OnGetGraphYear(int nyear)
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            HhvnUsers.SetYear(nyear, UserID);
            return new JsonResult("ok");
        }
        public JsonResult OnGetCheckRepPdf(long companyID, string nacceco)
        {
            try
            {


                UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
                Companies curCompany = Companies.Get_CompanyRow(companyID);
                List<int> curCompanyYearList = Companies.Get_CompanyReportYearMainMizan(companyID);
                curCompanyYearList.Sort();
                int nyear = curCompanyYearList.Max();
     
     


                var codde = NaceCode.GetRow_NaceCodes(Convert.ToInt32(nacceco));

                var str = DateTime.Now.ToString("yyyyMMddHHmm");
                string NewRepName = "FinansalDurumRapor-" + str + curCompany.TaxID.ToString() + ".pdf";
                var FileDocz = "FileContent/" + NewRepName;
                var FileDic = "wwwroot\\FileContent\\" + NewRepName;

                string filePathZ = WebHelper.path;
                string FilePath = System.IO.Path.Combine(filePathZ, FileDic);



                if (curCompanyYearList.Count >= 4)
                {
                    DynamicReportfour report = ReportCheckZoneMain.getReportMizanFour(curCompany.ID, codde.ID.ToString(), UserID, curCompanyYearList);
                    report.CreateDocument();
                    report.ExportToPdf(FilePath);
                    CompanyQnbReport.Set_Report(companyID, 1111, NewRepName);
                }
                else
                {
                    DynamicReport report = ReportCheckZoneMain.getReportMizan(curCompany.ID, codde.ID.ToString(), UserID, curCompanyYearList);
                    report.CreateDocument();
                    report.ExportToPdf(FilePath);
                    CompanyQnbReport.Set_Report(companyID, 1111, NewRepName);
                }


                return new JsonResult(FileDocz);

            }
            catch (Exception ex)
            {
                var chk = ex;
                return new JsonResult(ex.ToString());


            }




        }
      
        public JsonResult OnGetCheckUrl(long fileID)
        {
            try
            {
                 
                CompanyQnbReport nlist = CompanyQnbReport.Get_CompanyReport(fileID);
               
                string FileDocz = "FileContent/" + nlist.ReportName;
                
                return new JsonResult(FileDocz);

            }
            catch (Exception ex)
            {
                var chk = ex;
                return new JsonResult(ex.ToString());


            }




        }
    }
}
