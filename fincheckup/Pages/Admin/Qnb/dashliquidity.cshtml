@functions {
    public class IndexModel : PageModel
    {
        public IEnumerable<YearResult> myearResult;
        public long UserID;
        public long CompID;
        public string CompName;
        public int CompCount;
        public int YearCount;
        public List<DashBilancoView> nRequestListChk;
        public HhvnUsers CurrentUser;
        public IEnumerable<Companies> mreqListCompany;
        public List<DashBilancoView> nRequestList; 
        public List<DashWCapitalShortViewChart> nRequestListViewChart;
        public string NetIsletme { get; set; }
        public decimal NetIsletmeT { get; set; }
        public string CariOran { get; set; }
        public string NakitOran { get; set; }
        public void OnGet()
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));

            myearResult = YearResult.getValue();
            mreqListCompany = Companies.Getby_User(UserID);
            CompID = mreqListCompany.Where(x => x.IsDefault == 1).FirstOrDefault().ID;

            HhvnUsers.SetYearMain(CompID, UserID);
            CurrentUser = HhvnUsers.GetRow_User(UserID);
            nRequestListChk = DashGelirTablosu.Get_MAINRESULT(CurrentUser.SelectedYear, CompID);


            CompName = mreqListCompany.Where(x => x.IsDefault == 1).FirstOrDefault().CompanyName;

            YearCount = TBLXml.GetYearByComapnyID(CompID);
            CompCount = mreqListCompany.Count();

            var chkkkt    = DashLikidite.Get_MainList(CurrentUser.SelectedYear, CompID);
            if (chkkkt.Count<1)
            {
                nRequestList = DashLikiditeViewMain.getList(CurrentUser.SelectedYear, CompID);
            }
            else
            {
                nRequestList = chkkkt;
            }

            try
            {
                if (nRequestListChk.Count>0)
                {
                    var val5 = nRequestListChk.Where(x => x.TypeID == 333).FirstOrDefault().getTotalInt();
                    if (val5 == 0)
                    {
                        val5 = 1;
                    }
                    decimal chkt = Convert.ToDecimal(nRequestListChk.Where(x => (x.TypeID == 111)).FirstOrDefault().getTotalInt() - nRequestListChk.Where(x => (x.TypeID == 15)).FirstOrDefault().getTotalInt());
                    NetIsletmeT = chkt / Convert.ToDecimal(val5);
                    if (NetIsletmeT < 0)
                    {
                        NetIsletmeT = NetIsletmeT * -1;
                    }

                    NetIsletme = NetIsletmeT.ToString("F", new CultureInfo("en-US", false));
                }


            }
            catch (Exception)
            {

                NetIsletme = (0).ToString("F", new CultureInfo("en-US", false));
            }

            //DashLikiditeViewMain.getLikiditeORANT(CurrentUser.SelectedYear, CompID);

            //    NakitOran = DashGelirTablosuViewMain.getDonemKarZarar(CurrentUser.SelectedYear, CompID);
            DashBilancoView wwn = DashLikidite.Get_LikiditeORANT(CurrentUser.SelectedYear, CompID).FirstOrDefault();
            nRequestListViewChart = DashWCapitalShortViewList.getListDashWChart(wwn);
        }

       
        public JsonResult OnGetGraphYear(int nyear)
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            HhvnUsers.SetYear(nyear, UserID);
            return new JsonResult("ok");
        }
        
    }
}
