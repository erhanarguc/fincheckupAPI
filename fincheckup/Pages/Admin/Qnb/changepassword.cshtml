    public class IndexModel : PageModel
    {
        public long UserID;
        public HhvnUsers CurrentUser; 
        public IEnumerable<Companies> mreqListCompany;
        public List<UserTypes> mreqListUserType;
        public IEnumerable<Cities> mreqListCitiy;
        public IEnumerable<YearResult> myearResult;

        public HhvnUsers mrequest;

        public string mreqListCitiystr { get; set; }

        public void OnGet()
        {
            myearResult = YearResult.getValue();
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);
            
                mrequest = HhvnUsers.GetRow_User(UserID);
                mrequest.Password = PassWordHash.Decrypt(mrequest.Password);
            
            mreqListUserType = UserTypes.Get_Types();


            mreqListCompany = new List<Companies>();

            mreqListCompany = Companies.Getby_User(UserID);
            mrequest.CompanyList = mreqListCompany.Select(x => x.ID).ToList();

            mreqListCitiystr = string.Join(";", mrequest.CompanyList);

        }

     
        public JsonResult OnGetSalerCity(DataSourceLoadOptions options)
        {


            mreqListCitiy = Cities.Get_Cities();
            return new JsonResult(DataSourceLoader.Load(mreqListCitiy, options));

        }
       
     
        public JsonResult OnGetSalerCompany(DataSourceLoadOptions options, string dt1)
        {

            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);
            mreqListCompany = new List<Companies>();

            if (CurrentUser.UserTypeID == 1001)
            {
                mreqListCompany = Companies.Get_All();
            }
            else if (CurrentUser.UserTypeID == 4)
            {
                mreqListCompany = Companies.Getby_User(UserID);
            }
            return new JsonResult(DataSourceLoader.Load(mreqListCompany, options));

        }
