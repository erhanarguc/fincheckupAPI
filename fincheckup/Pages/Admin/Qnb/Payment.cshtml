@section Scripts{
    <script src="~/js/polyfill.min.js"></script>
    <script src="/assets/plugins/jquery-steps/jquery.steps.js"></script>


    <script>


        var itemCodecontent = "";
        function funcErrorOpena(inputz) {
            itemCodecontent = inputz;
            const popuprz = $("#popuperrora").dxPopup("instance");
            popuprz.option("contentTemplate", null);
            popuprz.option("contentTemplate", $("#popup-templatezzerra"));
            popuprz.show();
        }
        function funcErrorClosea() {
            const popuprz = $("#popuperrora").dxPopup("instance");

            popuprz.hide();
        }
        function funcErrorOpenanon(inputz) {
            itemCodecontent = inputz;
            const popuprz = $("#popuperroranon").dxPopup("instance");
            popuprz.option("contentTemplate", null);
            popuprz.option("contentTemplate", $("#popup-templatezzerranon"));
            popuprz.show();
        }
        function funcErrorCloseanon() {
            const popuprz = $("#popuperroranon").dxPopup("instance");

            popuprz.hide();
        }
        function funcErrorOpen() {
            document.getElementById('uploadInput').value = null;
            const popuprz = $("#popuperror").dxPopup("instance");

            popuprz.show();
        }
        function funcErrorClose() {
            const popuprz = $("#popuperror").dxPopup("instance");

            popuprz.hide();
        }
        function odemeyap() {
            // $('#paymentButton').click();
            var Is3Dtxt = "off";
            var chkd = $("#tred").dxCheckBox("instance").option("value");
            var amounttxt = $("#amounttxt").html();  
            var orderidtxt = $("#orderid").val();
            if (chkd == true || chkd == "true") { Is3Dtxt = "on"; }

            console.log(orderidtxt);



            console.log("entered");
            var form = $("#payment-form")
            var datas = JSON.stringify(form.serialize()) + "&Is3D=" + Is3Dtxt + "&Amount=" + amounttxt + "&OrderId=" + orderidtxt;
            console.log(datas);
            $.ajax({
                type: 'POST',
                dataType: 'json',
                data: datas,
                url: '/Transaction/PaySmartNomb/',
                success: function (data) {

                    const result = jQuery.parseJSON(data);
                    console.log(data);
                    // $("#modalHeader").text(result.status_description);
                    // $("#modalBody").text(`Status Code : ${result.status_code}`);
                    // $('#btnResultModel').click();
                    if (data.includes("100")) { funcErrorOpenanon("Payment process successful"); } else { funcErrorOpena("Payment Failed"); }
                    

                },
                error: function (err) {
                    console.log(err);
                }
            });


            return false;
        }


        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }
        function loadPanel_shown(e) {
            setTimeout(function () {
                e.component.hide();
            }, 610000);
        }


        var txcompname = $("txtcompname").val();

        function formatMessage(e) {

            return $("#txtcompname").val();
        }



    </script>

