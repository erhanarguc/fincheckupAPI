        public JsonResult OnGetCheckRep(long companyID, int nyear, string nacceco)
        {
            try
            {
                UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
                var mreqListCompany5 = Companies.Getby_User(UserID);
                CompID = mreqListCompany5.Where(x => x.IsDefault == 1).FirstOrDefault().ID;
                int  YearCountchk = TBLXml.GetYearByComapnyID(CompID);

                if (YearCountchk < 1)
                {

                    return new JsonResult("nok");
                }


                var codde = NaceCode.GetRow_NaceCodes(Convert.ToInt32(nacceco));

                IEnumerable<int> yearCount = Companies.Get_CompanyReportYear(companyID);
                List<int> yearCountFull = Companies.Get_CompanyReportYearFull(companyID);

                int repcount = CompanyQnbReport.Get_CompanyReportCount(companyID);
                curCompany = Companies.Get_CompanyRow(companyID);
                NewRepName = curCompany.TaxID.ToString() + "-FinReport-" + (repcount + 1).ToString("D4") + ".pdf";
                yearCount = yearCountFull.Except(yearCount);
                // report.DataSource = objectDataSource;
                //report.PrintingSystem.Document.Name = "Finance_raporlar";
                //report.ExportToPdf("Finance_rreport.pdf", pdfOptions);

                //string contentType = "application/pdf";
                //using (MemoryStream ms = new MemoryStream())
                //{
                //    report.ExportToPdf(ms); return File(ms.ToArray(), contentType);
                //}
                var FileDic = "wwwroot\\FileContent\\" + NewRepName;

                //
                string filePathZ = WebHelper.path;
                string FilePath = System.IO.Path.Combine(filePathZ, FileDic);
                CompanyReportView grview = Companies.Get_CompanyReportView(companyID);
         
                yearCountFull.Sort();
                switch (yearCountFull.Count)
                {
                    case 1:
                        FinansRaporu report = ReportCheckZone.getReport(companyID, yearCount.ToList(), codde.ID.ToString(), UserID, yearCountFull[0], grview);
                        report.CreateDocument();
                        report.ExportToPdf(FilePath);
                        CompanyQnbReport.Set_Report(companyID, UserID, NewRepName); break;
                    case 2:
                        FinansRaporua reporta = ReportCheckZone.getReporta(companyID, yearCount.ToList(), codde.ID.ToString(), UserID, yearCountFull, grview);
                        reporta.CreateDocument();
                        reporta.ExportToPdf(FilePath);
                        CompanyQnbReport.Set_Report(companyID, UserID, NewRepName); break;
                    case 3:
                        FinansRaporub reportb = ReportCheckZone.getReportb(companyID, yearCount.ToList(), codde.ID.ToString(), UserID, yearCountFull, grview);
                        reportb.CreateDocument();
                        reportb.ExportToPdf(FilePath);
                        CompanyQnbReport.Set_Report(companyID, UserID, NewRepName); break;
                    case 4:
                        FinansRaporuc reportc = ReportCheckZone.getReportc(companyID, yearCount.ToList(), codde.ID.ToString(), UserID, yearCountFull, grview);
                        reportc.CreateDocument();
                        reportc.ExportToPdf(FilePath);
                        CompanyQnbReport.Set_Report(companyID, UserID, NewRepName); break;
                    default:
                        break;
                }


            }
            catch (Exception ex)
            {
                var chk = ex;
                return new JsonResult(ex.ToString());


            }

            //var FileDocz = "/FileContent/" + NewRepName;

            //Send the File to Download.
            return new JsonResult("ok");

        }
