        public JsonResult OnGetGraphMonth(int nmon, long comid)
        {

            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);
            List<TBLXmlFolderFile> nlistr = TBLXmlFolderFile.GetList(comid, CurrentUser.SelectedYear, nmon);

            if (nlistr!=null&&nlistr.Count>0&& nlistr.Where(x=>x.IsFinished==1).Count()!=nlistr.Count())
            {
                return new JsonResult("nok");
            }

            return new JsonResult("ok");
        }
        public JsonResult OnGetGraphMonthText(int nmon, long comid)
        {

            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);
            List<TBLXmlFolderFile> nlistr = TBLXmlFolderFile.GetList(comid ,CurrentUser.SelectedYear, nmon);

            if (nlistr != null && nlistr.Count > 0 && nlistr.Where(x => x.IsFinished == 1).Count() != nlistr.Count())
            {
                int countt = nlistr.Where(x => x.Issetted == 1).Count();

                if (countt==nlistr.Count())
                {
                    return new JsonResult("Parçalı Edefter Verileri İşleniyor..");
                }


                if (countt==0)
                {
                    if (nlistr.Where(x => x.Issetted == 3).Count()>0)
                    {
                        return new JsonResult("Parçalı Edefter Verileri İşleniyor..");
                    }

                    return new JsonResult( " Yükleme işlemi devam ediyor..");
                }
                return new JsonResult(countt.ToString()+" Yüklendi.");
            }

            return new JsonResult("ok");
        }
