        public void OnGet()
        {
            myearResult = YearResult.getValue();
            mSourceResult = SourceResult.getValue();

            ListTextmainOk = "nok";
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);
            checkAddmin = 1;
            if (CurrentUser.ID != 9)
            {
                mSourceResult = SourceResult.getValue();
                checkAddmin = 0;
            }
            mreqListCompany = Companies.Getby_User(UserID);
            currenCompanie = mreqListCompany.Where(x => x.IsDefault == 1).FirstOrDefault();
            currentcompname = currenCompanie.CompanyName;
            curcomID = currenCompanie.ID;
            CompName = currenCompanie.CompanyName;
            curcomCount = mreqListCompany.Count();
            //currentUpload = UploadMain.Get_Data(DateTime.Now.Year, curcomID);

            CompID = mreqListCompany.Where(x => x.IsDefault == 1).FirstOrDefault().ID;
            YearCount = TBLXml.GetYearByComapnyID(CompID);
            CompCount = mreqListCompany.Count();
            List<TBLAAQnbSignLog> nlog = TBLAAQnbSignLog.Get_TBLAAQnbSignLog(curcomID).ToList();
            ListTextmain = "Belgenizi manuel olarak bilgisayarınızdan yükleyebilirsiniz.";

            curcomID = Companies.Getby_User(UserID).Where(x => x.IsDefault == 1).FirstOrDefault().ID;
            chkErrormonthIDChk = MainDash.Get_DatabyError(CurrentUser.SelectedYear, curcomID).Count();
            List<int> chkErrormonthID = MainDash.Get_DatabyError(CurrentUser.SelectedYear, curcomID).Where(x => x.TRowCount == 0).Select(x => x.MainMonth).ToList();
            currentUploadM = UploadMain.Get_Data(CurrentUser.SelectedYear, curcomID).OrderBy(x => x.MainMonth);

            if (chkErrormonthIDChk < 1)
            {
                currentUploadM.Select(c => { c.ErrorCount = -1; return c; }).OrderBy(x => x.MainMonth).ToList();
            }
            else
            {
                currentUploadM.Where(x => chkErrormonthID.Contains(x.MainMonth)).Select(c => { c.ErrorCount = -1; return c; }).OrderBy(x => x.MainMonth).ToList();
            }
            if (nlog != null && nlog.Count > 0)
            {
                chkErrormonthIDChk = 1;
                ListTextmainOk = "ok";
                ListTextmain = "Belgeleriniz Entegratör üzerinden otomatik yüklenme aşamasındadır lütfen bekleyiniz.";
            }
            currentUploadMOK = currentUploadM.Where(x => x.ErrorCount > -1);
            currentUploadMNoOK = currentUploadM.Where(x => x.ErrorCount < 0);
            currentMonth = currentUploadMNoOK.FirstOrDefault();
            currentUploadMMonth = new List<YearlyUploadResult>();
            if (currentMonth != null)
            {
                currentUploadMNoOK = currentUploadMNoOK.Except(currentUploadMMonth);
                currentUploadMMonth.Add(currentMonth);
            }


        }
        public JsonResult OnGetSalerMainNote()
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);

            curcomID = Companies.Getby_User(UserID).Where(x => x.IsDefault == 1).FirstOrDefault().ID;

            List<TBLXmlFolderFile> nlist = TBLXmlFolderFile.GetList(curcomID);

            if (nlist.Count < 1)
            {
                return new JsonResult("nok");
            }


            string listret = "";
            switch (nlist.Count)
            {
                case -1: listret = "Entegratörden Verilerin İletilmesi Bekleniyor"; break;
                case 0: listret = "Entegratörden Verilerin İletilmesi Bekleniyor"; break;
                case 1: listret = nlist[0].MainYear.ToString() + " Yılı " + nlist[0].MainMonth.ToString() + ". Ayı Entegratörden İndirildi İşleniyor"; break;
                case 2: listret = nlist[1].MainYear.ToString() + " Yılı " + nlist[1].MainMonth.ToString() + ". Ayı Entegratörden İndirildi İşleniyor"; break;
                case 3: listret = nlist[2].MainYear.ToString() + " Yılı " + nlist[2].MainMonth.ToString() + ". Ayı Entegratörden İndirildi İşleniyor"; break;
                case 4: listret = nlist[3].MainYear.ToString() + " Yılı " + nlist[3].MainMonth.ToString() + ". Ayı Entegratörden İndirildi İşleniyor"; break;
                case 5: listret = nlist[4].MainYear.ToString() + " Yılı " + nlist[4].MainMonth.ToString() + ". Ayı Entegratörden İndirildi İşleniyor"; break;
                default:
                    List<ViewSortlist> nlistsort = TBLXmlFolderFile.GetListSort(curcomID); listret = getresult(nlistsort);
                    break;
            }

            return new JsonResult(listret);

        }
        public string getresult(List<ViewSortlist> nlistsort)
        {
            string tt = " ";
            foreach (var item in nlistsort)
            {
                tt += item.MainYear.ToString() + " Yılı " + item.AllRecord.ToString() + " edefter " + item.AllSet.ToString() + " işlenen ";
            }
            return tt;
        }
