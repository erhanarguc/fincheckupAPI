        public JsonResult OnGetSalerMainQNBFin(DataSourceLoadOptions options, string nname)
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);

            var curcompanny = Companies.Getby_User(UserID).Where(x => x.IsDefault == 1).FirstOrDefault();
            ApiConnect app = new ApiConnect();
            var resultz = app.GetcheckSubmission(new SubmissionModel(curcompanny.TaxID));
            var cscsd = resultz.Result;
            if (cscsd.resultCode.Trim() == "1200" || cscsd.resultCode.Trim() == "1028")
            {
                app = new ApiConnect();
                var resultzz = app.GetsaveSubmissionPermission(new SubmissionModelT(curcompanny.TaxID, curcompanny.qnbCorporateId));
                var cscsdz = resultzz.Result;

                if (cscsdz.resultCode.Trim() == "1200" || cscsdz.resultCode.Trim() == "1030" || cscsdz.resultCode.Trim() == "1032")
                {
                    if (cscsdz.resultCode.Trim() != "1032")
                    {
                        var chkke = new TBLAAQnbSignLog(UserID, curcompanny.ID, 2, DateTime.Now, DateTime.Now, DateTime.Now.AddYears(1), 0, null, null, 0, null, null,1);
                        chkke.Save_TBLAAQnbSignLog();
                    }

                    var tttxz = ApiHelper.ToMessage(cscsdz.resultDescription);
                    return new JsonResult(tttxz);
                }
                else
                {
                    var tttxz = ApiHelper.ToMessage(cscsdz.resultDescription);
                    return new JsonResult(tttxz);
                }
            }


            var ttt = ApiHelper.ToMessage(cscsd.resultDescription);
            return new JsonResult(ttt);

        }
        public JsonResult OnGetSalerDate(DataSourceLoadOptions options)
