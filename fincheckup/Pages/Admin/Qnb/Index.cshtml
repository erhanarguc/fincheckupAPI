@functions {
    public class IndexModel : PageModel
    {

        public long UserID; 
        public long CompID; 
        public int YearCount;
        public Companies companny;
        public IEnumerable<Companies> mreqListCompany;
        public byte IsEldeger;
        public void OnGet()
        {


            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));

            mreqListCompany = Companies.Getby_User(UserID);

            companny = mreqListCompany.FirstOrDefault();
            IsEldeger = companny.IsEledger;

            CompID = companny.ID;
            UserCompany.setUpdateUser(UserID, CompID);
            YearCount = TBLXml.GetYearByComapnyID(CompID);
            if (YearCount!=0)
            {        
                 Response.Redirect("/admin/qnb/reportmain");
                YearCount = TBLXml.GetYearByComapnyIDMizan(CompID);
                if (YearCount != 0)
                { 
                    Response.Redirect("/admin/qnb/mizan/uploadmizan");
                }

            } 
        }
        public JsonResult OnGetChangeCompanyIsEledgerIndo(byte typeId, long compid)
        {


            if (typeId==1)
            {
                Companies.UpdateCompanyIsEledger(AppConstant.CompanyIsEdefter, compid);
            }
            else
            {
                Companies.UpdateCompanyIsEledger(AppConstant.CompanyIsMizanBeyanname, compid);
            }

            return new JsonResult("ok");

        }


    }
}
