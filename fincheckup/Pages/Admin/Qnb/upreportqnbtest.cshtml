        public JsonResult OnGetSalerDate(DataSourceLoadOptions options)
        {
            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);

            curcomID = Companies.Getby_User(UserID).Where(x => x.IsDefault == 1).FirstOrDefault().ID;

            var currentUploadM = ReportSetMain.Get_StatbyCompanyMainQNB(curcomID);


            return new JsonResult(DataSourceLoader.Load(currentUploadM.OrderBy(x => x.MainMonth).ToList(), options));

        }
        public JsonResult OnGetSalerYear(DataSourceLoadOptions options)
