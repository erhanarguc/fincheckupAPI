@page

@using fincheckup.Models.Hvvn
@using fincheckup.Models.NKolay

@model IndexModel
@{
    ViewData["Title"] = "Giriş Ekranı";
    Layout = "~/Pages/Shared/_LayoutFirm.cshtml";
}
@using DevExtreme.AspNet.Data
@using fincheckup.Models.NKolay.json
@using DevExtreme.AspNet.Mvc
@using fincheckup.Models.NKolay.ENTITY
@using fincheckup.ENTITY
@functions {
    public class IndexModel : PageModel
    {
        public long UserID;
        public HhvnUsers CurrentUser;
        public IEnumerable<Companies> mreqList;
        public List<CompanyQnbReview> mreqListrep; 
        public CompanyQnbReview mrequestrep;


        public void OnGet(int year = 2021)
        {

            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);

            if (CurrentUser.UserTypeID == 1001)
            {
                mreqList = Companies.Get_ReportCompanyQnb();
            }
            else
            {
                Response.Redirect("/logout?handler=logout");
            }

        }
        public IActionResult OnGetGetRep()
        {
            mreqList = new List<Companies>();
            mreqListrep = new List<CompanyQnbReview>();

            mreqList = Companies.Get_ReportCompanyQnb();

            foreach (var item in mreqList)
            {
                mrequestrep =   CompanyQnbReview.getReview(item.CreatedDate, item.qnbCorporateId, item.applicationId);
                mreqListrep.Add(mrequestrep);
            }


            if( mrequestrep==null)
            {mrequestrep= new CompanyQnbReview();}
            var FileDocz = mrequestrep.GetValues(mreqListrep);


            //Send the File to Download.
            return new JsonResult(FileDocz);
            //return File(filedata, contentType);

        }
       

    }
}
@section Styles {
    <link rel="stylesheet" href="/assets/plugins/jquery-datatable/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="/assets/plugins/morrisjs/morris.css">
    <style>
        .tdnormall {
            padding-top: 0.1rem !important;
            padding-left: 0.75rem !important;
            padding-bottom: 0.1rem !important;
            padding-right: 0.75rem !important;
        }

        #chartxt {
            max-height: 255px !important;
        }
    </style>
}
<section class="content home">
    <div class="container-fluid">
        <div class="block-header">
            <div class="row clearfix">
                <div class="col-lg-5 col-md-5 col-sm-12">
                    <h2>Şirket Listesi</h2>
                    <ul class="breadcrumb padding-0">
                        <li class="breadcrumb-item"><a href=""><i class="zmdi zmdi-home"></i></a></li>
                        <li class="breadcrumb-item active">Şirket Listesi</li>
                    </ul>
                </div>
                <div class="col-lg-7 col-md-7 col-sm-12">
                    <div class="input-group m-b-0">
                        <h3>Yükleme Yapan Şirket Listesi</h3>
                    </div>
                    <div class="input-group m-b-0">
                        @(Html.DevExtreme().Button()
                        .Text("Liste Al")
                        .Type(ButtonType.Default)
                        .StylingMode(ButtonStylingMode.Contained)
                        .Width(120)
                        .OnClick("funczone")
                    )
                    </div>
                </div>
            </div>
        </div>
        <div class="row clearfix">

            <div class="col-md-12 col-lg-12">
                <div class="card">
                    <div class="body">

                        <div class="row">

                            @(Html.DevExtreme().DataGrid<Companies>()
.ID("gridContainer").Paging(p => p.PageSize(25))
.Pager(p => p
.ShowPageSizeSelector(true)
.AllowedPageSizes(new[] { 10, 25, 50, 100 })
)
.ShowBorders(true).FilterRow(f => f.Visible(false)).ShowRowLines(true)
.RemoteOperations(true)
.SearchPanel(s => s
.Visible(true)
.HighlightCaseSensitive(true)
)
.Editing(e => e.Mode(GridEditMode.Popup).UseIcons(true)
)
.Columns(columns => {

    columns.AddFor(m => m.ID).Visible(false);
    columns.AddFor(m => m.LastLogin).Caption("Son Login Tarihi").AllowHeaderFiltering(true);
    columns.AddFor(m => m.CompanyName).Caption("Şirket").AllowHeaderFiltering(true);
    columns.AddFor(m => m.TaxID).Caption("Vergi No").AllowHeaderFiltering(false);
    columns.AddFor(m => m.ContactMail).Caption("ContactMail").AllowHeaderFiltering(false);
    columns.AddFor(m => m.ContactName).Caption("ContactName").AllowHeaderFiltering(false);
    columns.AddFor(m => m.CreatedDate).Caption("CreatedDate").AllowHeaderFiltering(false);
    columns.AddFor(m => m.qnbCorporateId).Caption("qnbCorporateId").AllowHeaderFiltering(false);
    columns.AddFor(m => m.qnbUserId).Caption("qnbUserId").AllowHeaderFiltering(false);
    columns.Add()
.CssClass("dx-command-edit dx-command-edit-with-icons centerdiv")
.CellTemplate(@<text>
         <a href="/admin/yonetim/reportshortdetail?id=<%= data.ID %>" class="btn btn-secondary btn-round btn-simple" title="Detail"><span class="dx-icon fa  fa-align-right"></span></a>
                   </text>);
})
        .DataSource(Model.mreqList
        )
    )
                        </div>



                    </div>

                </div>

            </div>




        </div>





    </div>
</section>


@section Scripts{



    <script>

        function funczone() {

             
            var turl = '/admin/yonetim/companyshort?handler=GetRep' ;

             
            $.ajax({
