@(Html.DevExtreme().LoadPanel()
        .ID("loadPanel")
        .ShadingColor("rgba(0,0,0,0.4)")
        .Position(p => p.Of("#employee"))
        .Visible(false)
        .ShowIndicator(true).Message("E-defter İşleniyor.. Lütfen Bekleyiniz...")
        .ShowPane(true).Height(300).Width(500)
        .Shading(true)
          .HideOnOutsideClick(false)
        .OnShown("loadPanel_shown")
    )
<input type="text" id="mainyear" name="mainyear" value="@Model.CurrentUser.SelectedYear" style="display:none" />
<input type="text" id="mainmonth" name="mainmonth" style="display:none" />






@section Scripts{


    <script>
        var tyear = $("#txtmyear").val();
        var misready = "nok";
        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }
        function loadPanel_shown(e) {
            setTimeout(function () {
                e.component.hide();
            }, 610000);
        }
        function getDataGridInstance() {
            return $("#grdContainerDefter").dxDataGrid("instance");
        }
        var txcompname = $("txtcompname").val();


        $("#frm").submit(function () {
            if (chklistmain.length > 1) {
                chklistmain = chklistmain.sort()
                var vals = $(this).serialize() + '&MainDescription=' + chklistmain.join(",");

                $.ajax({
                    url: "/JsonService/MainPost/FormSubmitCheck",
                    method: "POST",
                    data: vals,
                    success: function (data) {

                        location.reload();
                    }
                });


                $("#txtEntryNum").text("");
                $("#txtentrynuma").val("");
            }


        });

        var chklistmain = [];
        function notify(e) {
            var dataGrid = getDataGridInstance();
           // var data = selectedItems.selectedRowsData;
            var lalallalal = "";
            chklistmain = [];
            $.when.apply($, dataGrid.getSelectedRowsData().map(function (data) {
                chklistmain.push(data.AccountMainID)
                lalallalal = data.EntryNumber;
            })).done(function () {
                if (chklistmain.length > 1) {
                    $("#txtEntryNum").text(lalallalal + " Entry Numarası Seçildi");
                    $("#txtentrynuma").val(lalallalal);
                }
            });




        }
        function formatMessage(e) {

            return $("#txtcompname").val();
        }
        var chkReadyState = setInterval(function () {
            if (document.readyState == "complete") {

                clearInterval(chkReadyState);

                misready = "ok";
            }
        }, 100);
        function onCellPrepared(e) {

            if (e.columnIndex == 4 && e.rowType == "data") {
                var chkk = e.data;

                if (chkk.TxResult == "Bekleniyor" || parseInt(chkk.ErrorCount) < 0) {
                    e.cellElement.find(".dx-link-edit").remove();


                }
            }


        }
        function onRowPrepared(info) {
            if (info.rowType != "header" && info.data.TxResult == "Bekleniyor") {

                info.rowElement.addClass("orangecolor");
            } else if (info.rowType != "header") {
                info.rowElement.addClass("greencolor");
            }
        }
        var dt1 = "0";
        var compid = $("#txtmcomp").val();
        var monthid = 0;
        var year = $("#txtmyear").val();
        function getselectYearInstance() {
            return $("#slctYear").dxSelectBox("instance");
        }
        
        function selectYear_Initialized() {
            getselectYearInstance().option("value", parseInt($("#txtmyear").val()));
            var chkco = parseInt($("#txtyearcount").val());

            //if (chkco < 2) {
            //    getselectYearInstance().option("readOnly", true);
            //}


        }
        function functionsec(data) {

            monthid = data;
            $("#mainmonth").val(monthid);

            let elementz = document.getElementById("grdContainerDefter");
            let instancez = DevExpress.ui.dxDataGrid.getInstance(elementz);
            instancez.getDataSource().reload();
        }
 
        function selectYear_valueChanged(data) {
            var slctval = data.selectedItem.MYear;
            var turl = '/admin/dashboard?handler=GraphYear&nyear=' + slctval;

            if (misready == "ok" && tyear.toString() != slctval.toString()) {
                getLoadPanelInstance().show();
                $.ajax({
                    type: "GET",
                    url: turl,
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        if (response == "ok") {
                            location.reload();
                        }
                    },
                    failure: function (response) {
                        alert(response);
                    }
                });
            }

        }
    </script>

}

