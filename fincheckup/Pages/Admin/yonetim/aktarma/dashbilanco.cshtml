@(Html.DevExtreme().Popup()
        .ID("popupAktarma")
        .Width(515).Position(p => p.Of("#employee"))
        .Height(455).Position(p =>
        {
            p.My(HorizontalAlignment.Center, VerticalAlignment.Top);
            p.At(HorizontalAlignment.Center, VerticalAlignment.Top);
            p.Of("window");
            p.Offset(100, 100);
        })
        .Visible(false)
        .ShowTitle(false)
        .HideOnOutsideClick(false)
        .ContentTemplate(new TemplateName("popupAktarmaContent"))
        )

@using (Html.DevExtreme().NamedTemplate("popupAktarmaContent"))
{


    <br />
    <br />

    <div class="row">
        <div class="center1">  Yapılan Aktarma İşlemleri</div>
        <div class="col-12">
            @(Html.DevExtreme().DataGrid<DashMizanResult>().ColumnHidingEnabled(true).ID("grdContainerAktarma")
                .Scrolling(s => s
                .Mode(GridScrollingMode.Virtual)
                .RowRenderingMode(GridRowRenderingMode.Virtual)
                )
                .Paging(p => p.PageSize(10))
                .ColumnAutoWidth(true).ShowBorders(false)
                .HeaderFilter(f => f.Visible(true))
                .WordWrapEnabled(true).RowAlternationEnabled(true)
                .ShowBorders(true).DataSource(d => d.RemoteController().LoadUrl(Url.Page(null, "AktarmaResult")).LoadParams(new { nyear = new JS("function() {return tyear; }"), compid = new JS("function() {return mcompid; }") })).Columns(columns =>
                {
                    columns.AddFor(m => m.Description).Caption("Açıklama ").CssClass("custom");
                    columns.AddFor(m => m.Amount).Caption("Değer").CssClass("custom").Format(Format.FixedPoint);



                })
                )
            <br />
        </div>
        <div class="center1"> Donuk Alacak İşlemleri</div>
        <div class="col-12">
            @(Html.DevExtreme().DataGrid<DashMizanResult>().ColumnHidingEnabled(true).ID("grdContainerDonuk")
                .Scrolling(s => s
                .Mode(GridScrollingMode.Virtual)
                .RowRenderingMode(GridRowRenderingMode.Virtual)
                )
                .Paging(p => p.PageSize(10))
                .ColumnAutoWidth(true).ShowBorders(false)
                .HeaderFilter(f => f.Visible(true))
                .WordWrapEnabled(true).RowAlternationEnabled(true)
                .ShowBorders(true).DataSource(d => d.RemoteController().LoadUrl(Url.Page(null, "DonukResult")).LoadParams(new { nyear = new JS("function() {return tyear; }"), compid = new JS("function() {return mcompid; }") })).Columns(columns =>
                {
                    columns.AddFor(m => m.Description).Caption("Açıklama ").CssClass("custom");
                    columns.AddFor(m => m.Amount).Caption("Değer").CssClass("custom").Format(Format.FixedPoint);



                })
                )
            <br />
        </div>
    </div>

    <div class="center13">
        <p style="text-align:right">
            @(Html.DevExtreme().Button().ID("eee1zyy")
                .Text("Kapat")
                .Type(ButtonType.Normal)
                .StylingMode(ButtonStylingMode.Contained)
                .Width(181)
                .OnClick("funcAktarmaPanelClose")
                )
        </p>
    </div>

}



