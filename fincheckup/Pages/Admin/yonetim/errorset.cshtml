@section Scripts{
 

    <script>

        function buildValidationSuggestionRequest() {
            var form = $("#formzz").dxForm("instance");
            var data = form.option("formData");
            return JSON.stringify(data);
        } 
        $("#frmzz").submit(function (e) {
            e.preventDefault();
            var vals = $(this).serialize();
            $("#grdContainerDefter").dxDataGrid("getDataSource").reload();

            var form = $("#formzz").dxForm("instance");
            var data = form.option("formData");

            return false;
        });
        var tyear = $("#txtmyear").val();
        var misready = "nok";
        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }
        function loadPanel_shown(e) {
            setTimeout(function () {
                e.component.hide();
            }, 610000);
        }
        function getDataGridInstance() {
            return $("#grdContainerDefter").dxDataGrid("instance");
        }
        var txcompname = $("#txtcompname").val();

        
        $("#frm").submit(function (e) {
            e.preventDefault();
            console.log($("#maindesc").val());
            var chklist = $("#maindesc").val();
            if (chklist.length > 1) {
             
                var vals = $(this).serialize() + '&MainDescription=' + chklist;
                console.log(vals);
             //   location.href = "/admin/yonetim/errorset?nlist=" + chklistmain.join(",");

                $.ajax({
                    url: "/JsonService/MainPost/FormSubmitError",
                    method: "POST",
                    data: vals,
                    success: function (data) {

                        location.reload();
                    }
                });


                $("#txtEntryNum").text("");
                $("#txtentrynuma").val("");
            }

            return false;
        });

        function convertdat(str) {
            var date = new Date(str),
                mnth = ("0" + (date.getMonth() + 1)).slice(-2),
                day = ("0" + date.getDate()).slice(-2);
            return [date.getFullYear(), mnth, day].join("-");
        }

        function datumchage(e) {

            console.log(e);
           var txttt=convertdat(e.value);
            $("#maindatumm").val(txttt);
        }

        function selectchage(e) {

            console.log(e);
            console.log(e.value);
            
            $("#maincommpid").val(e.value);
        }
        var chklistmain = [];
        function notify(e) {
       
            var dataGrid = getDataGridInstance();
           // var data = selectedItems.selectedRowsData;
            var lalallalal = "";
            chklistmain = [];
            $.when.apply($, dataGrid.getSelectedRowsData().map(function (data) {
                chklistmain.push(data.AccountMainID)
                lalallalal = data.EntryNumber;
            })).done(function () {
                if (chklistmain.length > 1) {
                    $("#txtEntryNum").text(lalallalal + " Entry Numarası Seçildi");
                    $("#txtentrynuma").val(lalallalal);
                }
                
                location.href = "/admin/yonetim/errorset?tlist=" + chklistmain.join(",") + "&compid=" + $("#maincommpid").val() + "&datu=" + $("#maindatumm").val();
            });
           

            return false;

            
        }
        function formatMessage(e) {

            return $("#txtcompname").val();
        }
        var chkReadyState = setInterval(function () {
            if (document.readyState == "complete") {

                clearInterval(chkReadyState);

                misready = "ok";
            }
        }, 100);
        function onCellPrepared(e) {

            if (e.columnIndex == 4 && e.rowType == "data") {
                var chkk = e.data;

                if (chkk.TxResult == "Bekleniyor" || parseInt(chkk.ErrorCount) < 0) {
                    e.cellElement.find(".dx-link-edit").remove();


                }
            }


        }
        function onRowPrepared(info) {
            if (info.rowType != "header" && info.data.TxResult == "Bekleniyor") {

                info.rowElement.addClass("orangecolor");
            } else if (info.rowType != "header") {
                info.rowElement.addClass("greencolor");
            }
        }
        var dt1 = "0";
        var compid = $("#txtmcomp").val();
        var monthid = 0;
        var year = $("#txtmyear").val();
      
       

        
        
    </script>

}

