        public JsonResult OnGetCheckRepPdf(long companyID, int nyear, int nmonth)
        {
            try
            {
                string FileDocz = "";

                UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)); 
                Companies curCompany = Companies.Get_CompanyRow(companyID);
                List<CompanyReport> nlist = CompanyReport.Get_CompanyReportList(companyID);
                nlist = nlist.Where(x => x.MainMonth == nmonth && x.MainYear == nyear && x.FileTypeID == ReportConstant.FileTypePDF && x.ReportTypeID == ReportConstant.ReportTypeAccounting).ToList();

                if (nlist.Count>0)
                {
                    FileDocz = "FileContent/" + nlist[0].ReportName;
                    return new JsonResult(FileDocz);
                }
                var csvId = TBLXml.GetComapnyIDByMonth(companyID, nmonth, nyear);
                string NewRepName = "MuhasebeKayitRapor-" + curCompany.TaxID.ToString() + nyear.ToString() + "-" + nmonth.ToString() + ".pdf";
                FileDocz = "FileContent/" + NewRepName;
                var FileDic = "wwwroot\\FileContent\\" + NewRepName;


                string filePathZ = WebHelper.path;
                string FilePath = System.IO.Path.Combine(filePathZ, FileDic);

                List<DataViewer> ncheck = new List<DataViewer>();
                List<DataViewer> ncheckzone = new List<DataViewer>();
                var filelist = TBLXmlFile.Get_TBLXmlIDlist(csvId);
                foreach (var item in filelist)
                {
                    ncheck = MainDash.DataViewerMainSourceT(nyear, companyID, nmonth, item.ID);
                    ncheckzone.AddRange(ncheck);
                    Thread.Sleep(1000);
                }
                //  List<DataViewer> ncheck = MainDash.DataViewerMainSourceT(nyear, companyID, nmonth);
                List<DataViewer> ncheckMain = ErrorCheckMain.Get_ReportSetAll(nyear, companyID, nmonth);
                ncheckzone.AddRange(ncheckMain);
                ncheck = ncheckzone;
                if (ncheck.Count<1)
                {
                    return new JsonResult("nok");
                }

                KontrolRaporu report = CompanyReportHelper.getKontrolRaporu(nyear, companyID, nmonth, ncheck);
                report.CreateDocument();
                report.ExportToPdf(FilePath);
                CompanyReport.Set_Report(companyID, UserID, NewRepName, ReportConstant.FileTypePDF, ReportConstant.ReportTypeAccounting, nmonth, nyear, 0);

                return new JsonResult(FileDocz);

            }
            catch (Exception ex)
            {
                var chk = ex;
                return new JsonResult(ex.ToString());


            }


          

        }
        public JsonResult OnGetCheckRepXls(long companyID, int nyear, int nmonth)
        {
            try
            {
                string FileDocz = "";
                UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
                Companies curCompany = Companies.Get_CompanyRow(companyID);

                List<CompanyReport> nlist = CompanyReport.Get_CompanyReportList(companyID);
                nlist = nlist.Where(x => x.MainMonth == nmonth && x.MainYear == nyear && x.FileTypeID == ReportConstant.FileTypeExcel && x.ReportTypeID == ReportConstant.ReportTypeAccounting).ToList();

                if (nlist.Count > 0)
                {
                    FileDocz = "FileContent/" + nlist[0].ReportName;
                    return new JsonResult(FileDocz);
                }
                var csvId = TBLXml.GetComapnyIDByMonth(companyID, nmonth, nyear);
                string NewRepName = "MuhasebeKayitRapor-" + curCompany.TaxID.ToString() + nyear.ToString() + "-" + nmonth.ToString() + ".xlsx";
                FileDocz = "FileContent/" + NewRepName;
                var FileDic = "wwwroot\\FileContent\\" + NewRepName;


                string filePathZ = WebHelper.path;
                string FilePath = System.IO.Path.Combine(filePathZ, FileDic);
                List<DataViewer> ncheck = new List<DataViewer>();
                List<DataViewer> ncheckzone = new List<DataViewer>();
                var filelist = TBLXmlFile.Get_TBLXmlIDlist(csvId);
                foreach (var item in filelist)
                {
                    ncheck = MainDash.DataViewerMainSourceT(nyear, companyID, nmonth, item.ID);
                    ncheckzone.AddRange(ncheck);
                    Thread.Sleep(1000);
                }
                List<DataViewer> ncheckMain = ErrorCheckMain.Get_ReportSetAll(nyear, companyID, nmonth);
                ncheckzone.AddRange(ncheckMain);
                ncheck = ncheckzone;

                if (ncheck.Count < 1)
                {
                    return new JsonResult("nok");
                }
                KontrolRaporu report = CompanyReportHelper.getKontrolRaporu(nyear, companyID, nmonth, ncheck);
                report.CreateDocument();
                report.ExportToXlsx(FilePath);
                CompanyReport.Set_Report(companyID, UserID, NewRepName, ReportConstant.FileTypeExcel, ReportConstant.ReportTypeAccounting, nmonth, nyear, 0);

                return new JsonResult(FileDocz);

            }
            catch (Exception ex)
            {
                var chk = ex;
                return new JsonResult(ex.ToString());


            }

 

        }

    }
