        public JsonResult OnGetSalerMainChk(DataSourceLoadOptions options, int monthid)
        {
            mrequestDataViewer = new DataViewerMain();
            if (monthid < 1)
            {
                return new JsonResult(DataSourceLoader.Load(mrequestDataViewer.EntryData, options));
            }

            UserID = Int64.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier));
            CurrentUser = HhvnUsers.GetRow_User(UserID);

            curcomID = Companies.Getby_User(UserID).Where(x => x.IsDefault == 1).FirstOrDefault().ID;

            mrequestDataViewer.SetDataViewer(MainDash.DataViewerMainMonth(CurrentUser.SelectedYear, curcomID, monthid));

            return new JsonResult(DataSourceLoader.Load(mrequestDataViewer.EntryData, options));

        }
        public JsonResult OnGetSalerMainZeta(DataSourceLoadOptions options, int monthid)
