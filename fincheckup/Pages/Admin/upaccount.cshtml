                }
            });


        }
        function functionupdatetax(data) {
            startit();
            var nnmonthid = data.split('_')[0];
            var mata = data.split('_')[1];
            var nnyear = $("#txtmyear").val();
            var fdatam = new FormData();
            fdatam.append('companyid', $("#txtcurcomide").val());
            fdatam.append('month', nnmonthid);
            fdatam.append('year', nnyear);
            console.log(data); console.log(mata); console.log(fdatam.toString());
   
           
            $.ajax({
                url: "/JsonService/Main/moodUpdateAccountCheck",
                method: "POST",
                statusCode: {
                    500: function () {
                        getLoadPanelInstance().hide();
                        Swal.fire({
                            title: 'Server Erişim Sorunuz. Lütfen Sayfayı Yenileyiniz...',
                            confirmButtonText: 'Yenile'
                        }).then((result) => {
                            /* Read more about isConfirmed, isDenied below */
                            if (result.isConfirmed) {

                                location.reload();
                            }
                        });
                    },
                    404: function () {
                        alert("Script 404");
                    }
                },
                contentType: false,
                data: fdatam,
                processData: false,
                cache: false,
                success: function (data) {
                    getLoadPanelInstance().hide();
                    if (data == "nok") {

                        Swal.fire(
                            'Hata!',
                            'Hata ile Karşılaşıldı!',
                            'error'
                        )
                    }
                    else if (data == "yok") {

                        Swal.fire(
                            'Bilgilendirme!',
                            'Kontroller Sonucunda Uyarı alan Kayıt Bulunamadı !',
                            'info'
                        )
                    }
                    else {
                        var arr = data.split('_');

                        dt1 = arr[0];

                        Swal.fire(
                            'Başarılı!',
                            'Rapor Oluşturuldu!',
                            'success'
                        )
                        setTimeout(function () {
                            location.reload();
                        }, 2000);


                    }


                }
            });


        }
        function getLoadPanelInstance() {
            return $("#loadPanel").dxLoadPanel("instance");
        }
        function loadPanel_shown(e) {
            setTimeout(function () {
                e.component.hide();
            }, 610000);
        }
        function functionupdate(data) {

            var monthide = data;
            $("#mainmonth").val(monthide);
            var compidz = $("#txtmcomp").val();

            var yearz = $("#txtmyear").val();
            window.open(
                '/admin/yonetim/reportpottax?nyear=' + yearz + '&nmon=' + compidz + '&nmont=' + monthide,
                '_blank' // <- This is what makes it open in a new window.
            );
        }

        var txcompname = $("txtcompname").val();

        function formatMessage(e) {

            return $("#txtcompname").val();
        }
 

 
 
    </script>

}

